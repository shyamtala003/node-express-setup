{
  "name": "express-setup",
  "version": "1.0.0",
  "description": "NodeJs(express) project setup",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "prettier --write . && node --watch --env-file=.env.dev ./src/index.js",
    "staging": "node --watch --env-file=.env.staging src/index.js",
    "production": "node --env-file=.env src/index.js",
    "lint": "eslint --config eslint.config.cjs .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyamtala003/node-express-setup.git"
  },
  "keywords": [
    "node-setup",
    "express-setup",
    "best",
    "project-setup",
    "node-23"
  ],
  "author": "shyam tala",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shyamtala003/node-express-setup/issues"
  },
  "homepage": "https://github.com/shyamtala003/node-express-setup#readme",
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  }
}
